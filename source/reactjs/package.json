        "build:dynamic": "webpack --mode production --config-name dynamic",
        "test": "jest --config jest.config.js",
        "test-update-snapshots": "jest --config jest.config.js -u",
        "update-code-coverage": "jest --config jest.config.js --coverage",
        "lint": "eslint -c .eslintrc.js \"src/**/*.{ts,tsx}\"",
        "coverage": "jest --coverage --coverageReporters=cobertura"
